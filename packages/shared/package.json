{
  "name": "@proof-league/shared",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./db/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:migrate": "tsx db/migrate.ts",
    "selftest": "tsx src/pick.selftest.ts && tsx src/config.selftest.ts && tsx src/outcome.selftest.ts && tsx src/pickset-merkle.selftest.ts && tsx src/pickset.selftest.ts && tsx src/intake.selftest.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "viem": "^2.56.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@proof-league/chain": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
